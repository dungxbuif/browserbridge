BROWSER_BRIDGE_AUTH_TOKEN=replace-with-random-secret
BROWSER_BRIDGE_LISTEN_ADDR=127.0.0.1:8788
BROWSER_BRIDGE_HTTP_URL=http://127.0.0.1:8788
DATABASE_URL=postgres://browserbridge:browserbridge@127.0.0.1:55432/browserbridge?sslmode=disable

MEZON_BOT_ID=
MEZON_BOT_TOKEN=
MEZON_HOST=gw.mezon.ai
MEZON_PORT=443
MEZON_USE_SSL=true
MEZON_TIMEOUT_MS=10000
MEZON_CHANNEL_ID=
MEZON_ADMIN_USER_ID=
BOT_POST_INTERVAL_SECONDS=3600
BOT_COMMAND_PREFIX=*bb
BOT_DEDUP_TTL_SECONDS=86400
BOT_MEDIA_CLAIM_TTL_SECONDS=300
BOT_SINGLE_HOST_LOCK=true
BOT_LOCK_FILE=

SOCIAL_MEDIA_PLATFORM=tiktok # tiktok or instagram
SOCIAL_MEDIA_SCAN_INTERVAL_SECONDS=1800
SOCIAL_MEDIA_USER_COOLDOWN_SECONDS=21600
SOCIAL_MEDIA_USER_CLAIM_TTL_SECONDS=900
SOCIAL_MEDIA_MAX_USERS_PER_TICK=3
SOCIAL_MEDIA_MAX_MEDIA_PER_USER=20
SOCIAL_MEDIA_PAGE_LOAD_WAIT_MS=5000
SOCIAL_MEDIA_WORKER_RUN_ONCE=false

TIKTOK_TAB_ID=
INSTAGRAM_TAB_ID=
INSTAGRAM_FOLLOWING_MAX_PAGES=200

# Google Drive upload. Use either GOOGLE_DRIVE_ACCESS_TOKEN for short tests,
# or refresh-token mode for normal use.
GOOGLE_DRIVE_ACCESS_TOKEN=
GOOGLE_DRIVE_CLIENT_SECRET_FILE=/absolute/path/client_secret_*.json
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_NAME=BrowserBridge Media
